{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "source": "arch",
        "padding": {
            "top": 1
        }
    },
    "modules": [
        "title",
        "separator",
        "os",
        "kernel",
        "cpu",
        {
            "type": "gpu",
            "detectionMethod": "pci"
        },
        "memory",
        "break",
        "colors"
    ]
}
